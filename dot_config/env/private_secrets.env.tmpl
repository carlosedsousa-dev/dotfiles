{{- /* Gerado a partir de ~/.config/chezmoi/chezmoi.toml (fora do git).
       Edite os valores com `chezmoi edit-config` e rode `chezmoi apply`. */ -}}
export OPENAI_API_KEY={{ .openaiKey | quote }}
export OPENAI_BASE_URL={{ .openaiUrl | default "https://api.openai.com/v1" | quote }}
export ANTHROPIC_API_KEY={{ .anthropicKey | quote }}
export ANTHROPIC_BASE_URL={{ .anthropicUrl | default "https://api.anthropic.com" | quote }}
export GITHUB_TOKEN={{ .githubToken | quote }}
